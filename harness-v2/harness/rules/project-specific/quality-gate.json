{
  "checks": [
    {
      "name": "Terminal",
      "command": ["../.venv/bin/python", "../scripts/verify.py"],
      "cwd": "."
    },
    {
      "name": "Web",
      "command": ["npm", "--prefix", "../web", "run", "verify"],
      "cwd": "."
    },
    {
      "name": "Harness V2 unit tests",
      "command": ["../.venv/bin/python", "-m", "unittest", "discover", "-s", "tests", "-v"],
      "cwd": "."
    },
    {
      "name": "Harness V2 Ruff",
      "command": ["../.venv/bin/python", "-m", "ruff", "check", "scripts/verify.py", "tests/test_verify.py"],
      "cwd": "."
    }
  ]
}
